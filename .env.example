# ==============================================================================
# PharmaLoop � Environment Variable Reference
# ==============================================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# Never copy .env into a Docker image � inject all variables at runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL  � used by lib/prisma.ts at runtime (pgbouncer pooler, port 6543)
# DIRECT_URL    � used by prisma.config.ts for Prisma CLI commands (direct connection, port 5432)
#                 Required for `prisma migrate` and `prisma db push`.
#
# Keep connection strings unquoted. The runtime defensively normalizes matching
# outer quotes for container launch paths that preserve them. If the password
# contains @, URL-encode it as %40.
#
# Example (no quotes):
# DATABASE_URL=postgresql://user:pass%40word@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://user:pass%40word@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"

# Optional � overrides the default 7d token expiry.
# Accepts values like "7d", "24h", "3600" (seconds). Default: 7d.
# JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Internal Worker
# ------------------------------------------------------------------------------
# Shared secret for the /api/internal/process-refills endpoint.
# Supplied in the x-internal-secret header by external schedulers (e.g. Cloud Scheduler).
INTERNAL_WORKER_SECRET="replace-with-a-secure-random-secret-for-internal-tasks"
# INTERNAL_SECRET is accepted only as a temporary compatibility fallback.

# ------------------------------------------------------------------------------
# OTP / Password Reset
# ------------------------------------------------------------------------------
OTP_HASH_SECRET="replace-with-a-secure-random-32-char-secret-for-otp-hmac"

# ------------------------------------------------------------------------------
# Brevo Transactional Email (HTTPS REST API)
# ------------------------------------------------------------------------------
# API Key from Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new key.
# Runs over HTTPS (port 443), fully compatible with Render Free deployments.
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# Google OAuth 2.0
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production OAuth redirect URI.
# Set to exactly the URI registered in Google Cloud Console for your deployment.
# If unset in production, set NEXT_PUBLIC_APP_URL instead.
# Example: https://pharmaloop.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Application base URL � used to construct the Google OAuth callback URI when
# GOOGLE_REDIRECT_URI is not explicitly set. Required in production.
# Example: https://pharmaloop.example.com
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# Database connection pool (pg.Pool)
# ------------------------------------------------------------------------------
# Max connections per Node process. Tune for Cloud Run instance count � max.
# Supabase free/pro pooler limits typically allow 15�100; default is 10.
# PG_POOL_MAX=10

# ------------------------------------------------------------------------------
# Delivery progression (demo vs production)
# ------------------------------------------------------------------------------
# Milliseconds per delivery stage (CONFIRMED ? PROCESSING ? SHIPPED ? DELIVERED).
# Development default: 10000 (10 seconds). Production default: 21600000 (6 hours).
# DELIVERY_PROGRESSION_STAGE_MS=10000

# ------------------------------------------------------------------------------
# Razorpay (test-mode keys only)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=